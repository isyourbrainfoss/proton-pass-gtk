{
  "id": "io.github.isyourbrainfoss.ProtonPassGtk",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "proton-pass-gtk",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--env=PROTON_PASS_LINUX_KEYRING=dbus"
  ],
  "cleanup": ["/include", "/lib/pkgconfig", "*.la", "*.a"],
  "modules": [
    {
      "name": "pass-cli",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 pass-cli /app/bin/pass-cli"
      ],
      "sources": [
        {
          "type": "file",
          "only-arches": ["x86_64"],
          "url": "https://proton.me/download/pass-cli/2.7.0/pass-cli-linux-x86_64",
          "sha256": "fd933e76179a5a33b295853e9c6696e49e584fe2141b1aafc63a3d78c0791cdb",
          "dest-filename": "pass-cli"
        },
        {
          "type": "file",
          "only-arches": ["aarch64"],
          "url": "https://proton.me/download/pass-cli/2.7.0/pass-cli-linux-aarch64",
          "sha256": "93918d5621593cac88956854d0f52cbc43851dcd9c01840ffe48a88b3be84c6b",
          "dest-filename": "pass-cli"
        }
      ]
    },
    {
      "name": "proton-pass-gtk",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
