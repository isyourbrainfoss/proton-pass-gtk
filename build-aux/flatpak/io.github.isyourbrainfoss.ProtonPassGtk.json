{
  "app-id": "io.github.isyourbrainfoss.ProtonPassGtk",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "proton-pass-gtk",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--env=PROTON_PASS_LINUX_KEYRING=dbus"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/proton-pass-gtk/cargo",
      "CARGO_NET_OFFLINE": "true",
      "CARGO_BUILD_JOBS": "2"
    }
  },
  "modules": [
    {
      "name": "pass-cli",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 pass-cli /app/bin/pass-cli"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://proton.me/download/pass-cli/2.7.0/pass-cli-linux-x86_64",
          "sha256": "fd933e76179a5a33b295853e9c6696e49e584fe2141b1aafc63a3d78c0791cdb",
          "dest-filename": "pass-cli",
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "file",
          "url": "https://proton.me/download/pass-cli/2.7.0/pass-cli-linux-aarch64",
          "sha256": "93918d5621593cac88956854d0f52cbc43851dcd9c01840ffe48a88b3be84c6b",
          "dest-filename": "pass-cli",
          "only-arches": [
            "aarch64"
          ]
        }
      ]
    },
    {
      "name": "proton-pass-gtk",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "target",
            "_build",
            "tools",
            ".flatpak-builder",
            "flatpak-build",
            "flatpak-repo",
            "screenshots"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
